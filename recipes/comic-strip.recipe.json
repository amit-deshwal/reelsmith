{
  "$schema": "../../schemas/recipe.schema.json",
  "schemaVersion": 1,
  "id": "comic-strip",
  "version": "1.0.0",
  "name": "Comic Strip",
  "category": "beat-cut",
  "description": "Turns the gang into a comic book: halftone pop-art colour, shots that break apart into tiles on every two beats, a shouty comic caption and a BOOM end card.",
  "tags": ["comic", "friends", "funny", "kids", "pop-art"],
  "preview": { "poster": "previews/comic-strip.jpg", "loop": "previews/comic-strip.mp4", "generatedFrom": "synthetic-sample" },
  "canvas": { "width": 1080, "height": 1920, "fps": { "num": 30, "den": 1 } },
  "duration": { "mode": "fitMusic", "minSec": 8, "targetSec": 16, "maxSec": 30 },
  "inputs": [
    { "id": "clips", "kind": "media", "accept": ["video", "image"], "min": 8, "max": 80, "label": "Clips and photos", "hint": "Big faces, poses and reactions", "constraints": { "minClipSec": 0.4 } },
    { "id": "music", "kind": "media", "accept": ["audio"], "min": 1, "max": 1, "label": "Upbeat song" },
    { "id": "caption", "kind": "text", "label": "Comic caption", "default": "meanwhile, on the trip...", "optional": true, "maxLength": 50 },
    { "id": "endCard", "kind": "text", "label": "End card", "default": "BOOM!", "optional": true, "maxLength": 20 }
  ],
  "params": [
    { "id": "panel", "type": "enum", "label": "Transition", "default": "tile-pop", "options": ["tile-pop", "slide-over", "flash", "cut"] }
  ],
  "music": { "inputId": "music", "required": true, "startPolicy": "firstDownbeat", "endPolicy": "endOnBar", "fadeOutSec": 0.4, "gainDb": -2, "clipAudioGainDb": -96, "duckUnderSpeech": false },
  "assembler": { "strategy": "beat-montage@1", "options": { "transitionParam": "panel", "autoTransitions": ["tile-pop"] }, "aiSelection": "optional" },
  "structure": [
    { "section": "opener", "lengthBeats": 4, "fill": "clips", "cutRule": "everyBar", "transition": "cut", "overlays": [ { "kind": "title", "text": "{{inputs.caption}}", "styleId": "caption", "animationIn": "pop", "position": "upperThird" } ] },
    { "section": "panels", "fill": "clips", "cutRule": "every2Beats", "transition": "auto" },
    { "section": "boom", "lengthBeats": 4, "fill": "clips", "cutRule": "everyBar", "transition": "flash", "overlays": [ { "kind": "title", "text": "{{inputs.endCard}}", "styleId": "boom", "animationIn": "pop", "position": "center" } ] }
  ],
  "styles": {
    "caption": { "fontFamily": "Bangers", "fontWeight": 400, "sizePx": 92, "color": "#FFE600", "textTransform": "uppercase", "align": "center", "shadow": { "color": "#000000", "blurPx": 0, "dx": 5, "dy": 5 } },
    "boom": { "fontFamily": "Bangers", "fontWeight": 400, "sizePx": 200, "color": "#FF3B30", "textTransform": "uppercase", "align": "center", "shadow": { "color": "#000000", "blurPx": 0, "dx": 8, "dy": 8 } }
  },
  "look": { "colorLook": "vivid", "reelLook": "comic-pop", "grain": 0, "vignette": 0 },
  "casting": { "opener": ["posing", "people", "portrait"], "closer": ["celebrating", "people"], "boost": ["laughing", "shouting", "posing", "portrait", "action"], "avoid": ["scenery", "detail"] },
  "agentHints": "Every shot should be a character beat: a face, a pose, a reaction. The last shot under the end card should be the biggest moment. Never repeat a clip.",
  "ratios": { "4:5": {}, "1:1": {} },
  "constraints": { "noRepeatClips": true, "insufficientMediaPolicy": "mergeShots", "keepChronological": false, "textSafeZone": true }
}
