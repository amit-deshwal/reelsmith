{
  "$schema": "../../schemas/recipe.schema.json",
  "schemaVersion": 1,
  "id": "cube-tour",
  "version": "1.0.0",
  "name": "Cube Tour",
  "category": "travel",
  "description": "The trip turns like a dice: each shot rolls in on a 3D cube turn, on every bar and then every two beats, with a golden grade, a big place title and a stats line.",
  "tags": ["travel", "3d", "cube", "stats"],
  "preview": { "poster": "previews/cube-tour.jpg", "loop": "previews/cube-tour.mp4", "generatedFrom": "synthetic-sample" },
  "canvas": { "width": 1080, "height": 1920, "fps": { "num": 30, "den": 1 } },
  "duration": { "mode": "fitMusic", "minSec": 10, "targetSec": 18, "maxSec": 40 },
  "inputs": [
    { "id": "clips", "kind": "media", "accept": ["video", "image"], "min": 8, "max": 60, "label": "Trip clips and photos", "constraints": { "minClipSec": 0.6 } },
    { "id": "music", "kind": "media", "accept": ["audio"], "min": 1, "max": 1, "label": "Song" },
    { "id": "place", "kind": "text", "label": "Place name", "placeholder": "Hampi", "optional": true, "maxLength": 30 },
    { "id": "stat", "kind": "text", "label": "Stats line", "placeholder": "3 days · 2 friends · 1 scooter", "optional": true, "maxLength": 50 }
  ],
  "params": [
    { "id": "turn", "type": "enum", "label": "Transition", "default": "cube-turn", "options": ["cube-turn", "slide-over", "whip-blur"] }
  ],
  "music": { "inputId": "music", "required": true, "startPolicy": "firstDownbeat", "endPolicy": "endOnBar", "fadeOutSec": 0.8, "gainDb": -3, "clipAudioGainDb": -96, "duckUnderSpeech": false },
  "assembler": { "strategy": "beat-montage@1", "options": { "transitionParam": "turn", "autoTransitions": ["cube-turn"] }, "aiSelection": "optional" },
  "structure": [
    { "section": "intro", "lengthBeats": 8, "fill": "clips", "cutRule": "everyBar", "transition": "auto", "overlays": [ { "kind": "placeName", "text": "{{inputs.place}}", "styleId": "place", "animationIn": "slideUp", "position": "upperThird" } ] },
    { "section": "roll", "fill": "clips", "cutRule": "every2Beats", "transition": "auto", "overlays": [ { "kind": "label", "text": "{{inputs.stat}}", "styleId": "stat", "animationIn": "fade", "position": "lowerThird", "atBeat": 0, "durationBeats": 8 } ] }
  ],
  "styles": {
    "place": { "fontFamily": "Bowlby One", "fontWeight": 400, "sizePx": 150, "color": "#FFFFFF", "textTransform": "uppercase", "align": "center", "shadow": { "color": "#00000099", "blurPx": 18, "dx": 0, "dy": 6 } },
    "stat": { "fontFamily": "Poppins", "fontWeight": 600, "sizePx": 54, "color": "#FFE7B0", "align": "center", "shadow": { "color": "#00000099", "blurPx": 10, "dx": 0, "dy": 3 } }
  },
  "look": { "colorLook": "warmFilm", "reelLook": "golden-hour", "grain": 0.05, "vignette": 0.1 },
  "casting": { "opener": ["scenery", "city"], "closer": ["people", "scenery"], "boost": ["scenery", "city", "people", "food"] },
  "agentHints": "Alternate wide and close shots so each cube face looks different. Keep the trip in order. Keep the place name to one or two words. Never repeat a clip.",
  "ratios": { "4:5": {}, "1:1": { "styles": { "place": { "sizePx": 120 } } } },
  "constraints": { "noRepeatClips": true, "insufficientMediaPolicy": "lengthenShots", "keepChronological": true, "textSafeZone": true }
}
