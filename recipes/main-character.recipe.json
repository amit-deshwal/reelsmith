{
  "$schema": "../../schemas/recipe.schema.json",
  "schemaVersion": 1,
  "id": "main-character",
  "version": "1.0.0",
  "name": "Main Character",
  "category": "other",
  "description": "A moody solo reel: bleach-bypass grade, a slow two-shot intro under a serif title, a flash-strobe burst, then whip-blur cuts every two beats that stay on you.",
  "tags": ["solo", "portrait", "moody", "dramatic", "creator"],
  "preview": { "poster": "previews/main-character.jpg", "loop": "previews/main-character.mp4", "generatedFrom": "synthetic-sample" },
  "canvas": { "width": 1080, "height": 1920, "fps": { "num": 30, "den": 1 } },
  "duration": { "mode": "fitMusic", "minSec": 8, "targetSec": 16, "maxSec": 30 },
  "inputs": [
    { "id": "clips", "kind": "media", "accept": ["video", "image"], "min": 8, "max": 60, "label": "Clips and photos of you", "hint": "Walking, looking back, close-ups, silhouettes", "constraints": { "minClipSec": 0.5 } },
    { "id": "music", "kind": "media", "accept": ["audio"], "min": 1, "max": 1, "label": "Song" },
    { "id": "title", "kind": "text", "label": "Title", "default": "main character energy", "optional": true, "maxLength": 40 }
  ],
  "params": [
    { "id": "hookSec", "type": "seconds", "label": "Strobe burst length", "default": 1.5, "min": 0.6, "max": 3, "step": 0.1 },
    { "id": "flashSec", "type": "seconds", "label": "Length of one flash", "default": 0.4, "min": 0.3, "max": 0.6, "step": 0.05 },
    { "id": "move", "type": "enum", "label": "Transition after the burst", "default": "whip-blur", "options": ["whip-blur", "zoom-through", "slide-over", "cut"] }
  ],
  "music": { "inputId": "music", "required": true, "startPolicy": "firstDownbeat", "endPolicy": "endOnBar", "fadeOutSec": 0.8, "gainDb": -3, "clipAudioGainDb": -96, "duckUnderSpeech": false },
  "assembler": { "strategy": "beat-montage@1", "options": { "transitionParam": "move", "autoTransitions": ["whip-blur"] }, "aiSelection": "optional" },
  "structure": [
    { "section": "intro", "lengthBeats": 8, "fill": "clips", "cutRule": "everyBar", "transition": "crossfade", "overlays": [ { "kind": "title", "text": "{{inputs.title}}", "styleId": "serif", "animationIn": "wordByWord", "position": "upperThird" } ] },
    { "section": "burst", "strobe": true, "fill": "clips", "transition": "flash" },
    { "section": "walk", "fill": "clips", "cutRule": "every2Beats", "transition": "auto" }
  ],
  "styles": {
    "serif": { "fontFamily": "Playfair Display", "fontWeight": 700, "sizePx": 96, "color": "#FFFFFF", "align": "center", "shadow": { "color": "#000000AA", "blurPx": 18, "dx": 0, "dy": 4 } }
  },
  "look": { "colorLook": "none", "reelLook": "moody-bleach", "grain": 0.1, "vignette": 0.2 },
  "casting": { "opener": ["portrait", "people"], "closer": ["portrait", "scenery"], "boost": ["portrait", "posing", "people"], "avoid": ["food"] },
  "agentHints": "Every shot should feature the same person. Open on a slow close-up, put the most striking poses in the strobe burst, and end on a walk-away or silhouette. Never repeat a clip.",
  "ratios": { "4:5": {} },
  "constraints": { "noRepeatClips": true, "insufficientMediaPolicy": "lengthenShots", "keepChronological": false, "textSafeZone": true }
}
