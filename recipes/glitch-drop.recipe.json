{
  "$schema": "../../schemas/recipe.schema.json",
  "schemaVersion": 1,
  "id": "glitch-drop",
  "version": "1.0.0",
  "name": "Glitch Drop",
  "category": "beat-cut",
  "description": "Night-out energy: a neon grade, a slow build cut every two beats, then the drop tears through every beat with RGB-split glitch cuts and a black end card.",
  "tags": ["night", "party", "glitch", "neon", "drop"],
  "preview": { "poster": "previews/glitch-drop.jpg", "loop": "previews/glitch-drop.mp4", "generatedFrom": "synthetic-sample" },
  "canvas": { "width": 1080, "height": 1920, "fps": { "num": 30, "den": 1 } },
  "duration": { "mode": "fitMusic", "minSec": 8, "targetSec": 16, "maxSec": 30 },
  "inputs": [
    { "id": "clips", "kind": "media", "accept": ["video", "image"], "min": 10, "max": 100, "label": "Night clips and photos", "hint": "Lights, crowds, dancing. Dark footage looks best with the neon grade.", "constraints": { "minClipSec": 0.3 } },
    { "id": "music", "kind": "media", "accept": ["audio"], "min": 1, "max": 1, "label": "Song with a big drop" },
    { "id": "caption", "kind": "text", "label": "Caption on the drop", "placeholder": "we did not sleep", "optional": true, "maxLength": 50 },
    { "id": "endCard", "kind": "text", "label": "End card", "placeholder": "saturday", "optional": true, "maxLength": 30 }
  ],
  "params": [
    { "id": "dropAtS", "type": "seconds", "label": "Drop time in the song (0 = auto)", "default": 0, "min": 0, "max": 600, "step": 0.01 },
    { "id": "cut", "type": "enum", "label": "Drop transition", "default": "chroma-glitch", "options": ["chroma-glitch", "flash", "whip-blur", "cut"] }
  ],
  "music": { "inputId": "music", "required": true, "startPolicy": "loudestSection", "endPolicy": "endOnBar", "fadeOutSec": 0.3, "gainDb": -2, "clipAudioGainDb": -96, "duckUnderSpeech": false },
  "assembler": { "strategy": "beat-montage@1", "options": { "dropDetection": "energyJump", "transitionParam": "cut", "autoTransitions": ["chroma-glitch"] }, "aiSelection": "optional" },
  "structure": [
    { "section": "build", "lengthBeats": 8, "fill": "clips", "cutRule": "every2Beats", "transition": "chroma-glitch" },
    { "section": "drop", "fill": "clips", "cutRule": "everyBeat", "transition": "auto", "overlays": [ { "kind": "title", "text": "{{inputs.caption}}", "styleId": "caption", "animationIn": "none", "position": "lowerThird" } ] },
    { "section": "end", "lengthBeats": 2, "fill": "none", "overlays": [ { "kind": "title", "text": "{{inputs.endCard}}", "styleId": "endcard", "animationIn": "fade", "position": "center" } ] }
  ],
  "styles": {
    "caption": { "fontFamily": "Unbounded", "fontWeight": 800, "sizePx": 64, "color": "#7CF8FF", "align": "center", "shadow": { "color": "#FF2BD6AA", "blurPx": 16, "dx": 0, "dy": 0 } },
    "endcard": { "fontFamily": "Unbounded", "fontWeight": 800, "sizePx": 72, "color": "#FF2BD6", "textTransform": "uppercase", "align": "center" }
  },
  "look": { "colorLook": "vivid", "reelLook": "neon-night", "grain": 0, "vignette": 0.1 },
  "casting": { "opener": ["dancing", "night", "people"], "closer": ["celebrating", "people"], "boost": ["night", "dancing", "celebrating", "city", "action"], "avoid": ["food", "detail"] },
  "agentHints": "Put the loudest, most chaotic shots on the drop. The build should be moody wides and lights. Never repeat a clip. If the footage is bright daylight, tell the user the neon grade suits night footage and offer a plain look.",
  "ratios": { "4:5": {}, "16:9": {} },
  "constraints": { "noRepeatClips": true, "insufficientMediaPolicy": "mergeShots", "keepChronological": false, "textSafeZone": true }
}
