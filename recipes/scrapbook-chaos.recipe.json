{
  "$schema": "../../schemas/recipe.schema.json",
  "schemaVersion": 1,
  "id": "scrapbook-chaos",
  "version": "1.0.0",
  "name": "Scrapbook Chaos",
  "category": "collage",
  "description": "A crayon-drawn scrapbook that keeps rearranging itself: a 3×3 grid, three strips, a 2×2, stacked halves, all on paper, ending on one full-screen shot with a handwritten title.",
  "tags": ["scrapbook", "collage", "crayon", "kids", "diary"],
  "preview": { "poster": "previews/scrapbook-chaos.jpg", "loop": "previews/scrapbook-chaos.mp4", "generatedFrom": "synthetic-sample" },
  "canvas": { "width": 1080, "height": 1920, "fps": { "num": 30, "den": 1 } },
  "duration": { "mode": "fitMusic", "minSec": 8, "targetSec": 18, "maxSec": 40 },
  "inputs": [
    { "id": "media", "kind": "media", "accept": ["image", "video"], "min": 9, "max": 40, "label": "Photos and clips", "hint": "15–25 is ideal; mix faces, food and places" },
    { "id": "music", "kind": "media", "accept": ["audio"], "min": 0, "max": 1, "label": "Song (optional)" },
    { "id": "title", "kind": "text", "label": "Closing title", "placeholder": "best summer ever", "optional": true, "maxLength": 40 }
  ],
  "params": [
    { "id": "gutter", "type": "integer", "label": "Gap between tiles (px)", "default": 22, "min": 0, "max": 60, "step": 2 },
    { "id": "radius", "type": "integer", "label": "Tile corner radius (px)", "default": 6, "min": 0, "max": 80, "step": 2 },
    { "id": "bg", "type": "color", "label": "Paper colour", "default": "#FFF1D0" }
  ],
  "music": { "inputId": "music", "required": false, "startPolicy": "firstDownbeat", "endPolicy": "endOnBar", "fadeOutSec": 1, "gainDb": -4, "clipAudioGainDb": -96, "duckUnderSpeech": false },
  "assembler": { "strategy": "collage-grid@1", "options": { "sequence": ["grid3x3", "split3v", "grid2x2", "split2h", "split2v"], "revealStaggerBeats": 0.25 }, "aiSelection": "optional" },
  "structure": [
    { "section": "grids", "fill": "layout", "cutRule": "everyBar" },
    { "section": "hero", "lengthBeats": 8, "fill": "clips", "overlays": [ { "kind": "title", "text": "{{inputs.title}}", "styleId": "hand", "position": "center", "animationIn": "pop" } ] }
  ],
  "styles": { "hand": { "fontFamily": "Caveat", "fontWeight": 700, "sizePx": 130, "color": "#FFFFFF", "shadow": { "color": "#00000099", "blurPx": 14, "dx": 0, "dy": 4 }, "align": "center" } },
  "look": { "colorLook": "none", "reelLook": "mixmedia-crayon", "grain": 0, "vignette": 0 },
  "agentHints": "Put faces in the bigger cells and keep similar colours in the same grid. The hero shot should be the happiest group moment.",
  "ratios": { "4:5": {}, "1:1": {} },
  "constraints": { "noRepeatClips": true, "insufficientMediaPolicy": "lengthenShots", "keepChronological": false, "textSafeZone": true }
}
