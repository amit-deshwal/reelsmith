{
  "$schema": "../../schemas/recipe.schema.json",
  "schemaVersion": 1,
  "id": "double-exposure",
  "version": "1.0.0",
  "name": "Double Exposure",
  "category": "other",
  "description": "An album-cover reel: the person becomes a silhouette filled with the landscape in two inks for the opening, the middle turns to a navy-and-gold duotone print, and it closes on another double exposure.",
  "tags": ["poster", "artsy", "solo", "duotone", "moody"],
  "preview": { "poster": "previews/double-exposure.jpg", "loop": "previews/double-exposure.mp4", "generatedFrom": "synthetic-sample" },
  "canvas": { "width": 1080, "height": 1920, "fps": { "num": 30, "den": 1 } },
  "duration": { "mode": "fitMusic", "minSec": 10, "targetSec": 18, "maxSec": 40 },
  "inputs": [
    { "id": "clips", "kind": "media", "accept": ["video", "image"], "min": 6, "max": 40, "label": "Clips and photos", "hint": "Portraits for the opening and closing shots, landscapes and textures for the middle", "constraints": { "minClipSec": 1 } },
    { "id": "music", "kind": "media", "accept": ["audio"], "min": 1, "max": 1, "label": "Slow song" },
    { "id": "title", "kind": "text", "label": "Title", "placeholder": "between two places", "optional": true, "maxLength": 40 }
  ],
  "params": [],
  "music": { "inputId": "music", "required": true, "startPolicy": "firstDownbeat", "endPolicy": "fadeOut", "fadeOutSec": 2, "gainDb": -4, "clipAudioGainDb": -96, "duckUnderSpeech": false },
  "assembler": { "strategy": "beat-montage@1", "options": {}, "aiSelection": "recommended" },
  "structure": [
    { "section": "cover", "lengthBeats": 8, "fill": "clips", "cutRule": "everyBar", "transition": "crossfade", "effects": [ { "assetId": "builtin:fx-double-exposure", "overrides": { "zoom": 1.6, "drift": 1 } } ], "overlays": [ { "kind": "title", "text": "{{inputs.title}}", "styleId": "serif", "animationIn": "fade", "position": "lowerThird" } ] },
    { "section": "print", "fill": "clips", "cutRule": "everyBar", "transition": "fluted-glass", "effects": [ { "assetId": "builtin:fx-duotone", "overrides": { "shadowColor": [0.06, 0.09, 0.28], "highlightColor": [1, 0.8, 0.45], "contrast": 1.3 } }, { "assetId": "builtin:fx-halftone", "overrides": { "dotSize": 5, "intensity": 0.35 } } ] },
    { "section": "back", "lengthBeats": 8, "fill": "clips", "cutRule": "everyBar", "transition": "crossfade", "effects": [ { "assetId": "builtin:fx-double-exposure", "overrides": { "zoom": 2, "drift": 1.5 } } ] }
  ],
  "styles": {
    "serif": { "fontFamily": "Fraunces", "fontWeight": 700, "sizePx": 92, "color": "#FFF4DE", "align": "center", "shadow": { "color": "#00000099", "blurPx": 14, "dx": 0, "dy": 3 } }
  },
  "look": { "colorLook": "mutedMatte", "effects": [ { "assetId": "builtin:fx-fine-grain", "overrides": { "strength": 0.06 } } ], "grain": 0.06, "vignette": 0.1 },
  "casting": { "opener": ["portrait", "people"], "closer": ["portrait", "people"], "boost": ["portrait", "scenery", "water", "detail"] },
  "agentHints": "The opening and closing sections need a clear person filling a good part of the frame (side profiles look great); the duotone middle should be landscapes and textures. Never repeat a clip.",
  "ratios": { "4:5": {}, "1:1": {} },
  "constraints": { "noRepeatClips": true, "insufficientMediaPolicy": "lengthenShots", "keepChronological": false, "textSafeZone": true }
}
