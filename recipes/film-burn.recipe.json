{
  "$schema": "../../schemas/recipe.schema.json",
  "schemaVersion": 1,
  "id": "film-burn",
  "version": "1.0.0",
  "name": "Film Burn",
  "category": "vlog",
  "description": "Found 8 mm memories: an old-film grade with dust and flicker, a burning light leak on every bar, in the order things happened, opening on a serif title and closing on a dip to black.",
  "tags": ["memories", "family", "film", "vintage", "nostalgic"],
  "preview": { "poster": "previews/film-burn.jpg", "loop": "previews/film-burn.mp4", "generatedFrom": "synthetic-sample" },
  "canvas": { "width": 1080, "height": 1920, "fps": { "num": 30, "den": 1 } },
  "duration": { "mode": "fitMusic", "minSec": 10, "targetSec": 18, "maxSec": 45 },
  "inputs": [
    { "id": "clips", "kind": "media", "accept": ["video", "image"], "min": 6, "max": 50, "label": "Clips and photos", "hint": "Family, friends, slow candid moments", "constraints": { "minClipSec": 1 } },
    { "id": "music", "kind": "media", "accept": ["audio"], "min": 1, "max": 1, "label": "Song" },
    { "id": "title", "kind": "text", "label": "Opening title", "placeholder": "summer of '26", "optional": true, "maxLength": 40 }
  ],
  "params": [
    { "id": "cutRule", "type": "enum", "label": "Cut on", "default": "everyBar", "options": ["every2Beats", "everyBar"] }
  ],
  "music": { "inputId": "music", "required": true, "startPolicy": "firstDownbeat", "endPolicy": "fadeOut", "fadeOutSec": 2, "gainDb": -4, "clipAudioGainDb": -96, "duckUnderSpeech": false },
  "assembler": { "strategy": "beat-montage@1", "options": { "autoTransitions": ["light-leak"] }, "aiSelection": "optional" },
  "structure": [
    { "section": "title", "lengthBeats": 8, "fill": "clips", "cutRule": "everyBar", "transition": "light-leak", "overlays": [ { "kind": "title", "text": "{{inputs.title}}", "styleId": "serif", "animationIn": "fade", "position": "center" } ] },
    { "section": "reel", "fill": "clips", "cutRule": "everyBar", "transition": "auto" },
    { "section": "fade", "lengthBeats": 4, "fill": "clips", "cutRule": "everyBar", "transition": "dipToBlack" }
  ],
  "styles": {
    "serif": { "fontFamily": "Libre Baskerville", "fontWeight": 700, "sizePx": 90, "color": "#FFF6E0", "align": "center", "shadow": { "color": "#000000AA", "blurPx": 18, "dx": 0, "dy": 3 } }
  },
  "look": { "colorLook": "warmFilm", "reelLook": "old-film", "grain": 0.25, "vignette": 0.25 },
  "casting": { "opener": ["scenery", "people"], "closer": ["people", "scenery"], "boost": ["people", "laughing", "portrait", "scenery"] },
  "agentHints": "Keep the real order of events. Prefer quiet, human moments over action. Never repeat a clip.",
  "ratios": { "4:5": {}, "4:3": {} },
  "constraints": { "noRepeatClips": true, "insufficientMediaPolicy": "lengthenShots", "keepChronological": true, "textSafeZone": true }
}
