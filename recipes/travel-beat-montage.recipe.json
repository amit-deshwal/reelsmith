{
  "$schema": "../../schemas/recipe.schema.json",
  "schemaVersion": 1,
  "id": "travel-beat-montage",
  "version": "1.0.0",
  "name": "Travel Beat Montage",
  "category": "travel",
  "description": "Fast vertical trip montage: a big place title on the intro beats, then cuts that land on the music, ending on a held final shot.",
  "tags": ["travel", "beat", "montage"],
  "preview": { "poster": "previews/travel-beat-montage.jpg", "loop": "previews/travel-beat-montage.mp4", "generatedFrom": "synthetic-sample" },
  "canvas": { "width": 1080, "height": 1920, "fps": { "num": 30, "den": 1 } },
  "duration": { "mode": "fitMusic", "minSec": 8, "targetSec": 20, "maxSec": 60 },
  "inputs": [
    { "id": "clips", "kind": "media", "accept": ["video", "image"], "min": 6, "max": 80, "label": "Trip clips and photos", "hint": "15–40 is ideal; mix wide views and details", "constraints": { "minClipSec": 0.5, "preferOrientation": "any" } },
    { "id": "music", "kind": "media", "accept": ["audio"], "min": 1, "max": 1, "label": "Song (your own file)" },
    { "id": "place", "kind": "text", "label": "Place name", "placeholder": "Harishchandragad", "optional": true, "maxLength": 40 }
  ],
  "params": [
    { "id": "cutRule", "type": "enum", "label": "Cut on", "default": "every2Beats", "options": ["everyBeat", "every2Beats", "everyBar"] },
    { "id": "accent", "type": "color", "label": "Title colour", "default": "#FFD23F" },
    { "id": "titleFont", "type": "font", "label": "Title font", "default": "Anton" },
    { "id": "transition", "type": "enum", "label": "Transition", "default": "cut", "options": ["cut", "crossfade", "flash", "zoomIn"] },
    { "id": "clipAudio", "type": "boolean", "label": "Keep some original sound", "default": false }
  ],
  "music": { "inputId": "music", "required": true, "startPolicy": "firstDownbeat", "endPolicy": "endOnBar", "fadeOutSec": 1.5, "gainDb": -3, "clipAudioGainDb": -96, "duckUnderSpeech": false },
  "assembler": { "strategy": "beat-montage@1", "options": { "introBeats": 8, "outroHoldBeats": 4, "speedRampOnDrop": false }, "aiSelection": "optional" },
  "structure": [
    { "section": "intro", "lengthBeats": 8, "fill": "clips", "cutRule": "everyBar", "overlays": [ { "kind": "placeName", "text": "{{inputs.place}}", "styleId": "title.big", "animationIn": "wordByWord", "position": "center", "atBeat": 0, "durationBeats": 8 } ] },
    { "section": "body", "fill": "clips", "cutRule": "every2Beats", "transition": "cut" },
    { "section": "outro", "lengthBeats": 4, "fill": "clips", "cutRule": "everyBar", "transition": "crossfade" }
  ],
  "styles": {
    "title.big": { "fontFamily": "Anton", "fontWeight": 400, "sizePx": 150, "color": "#FFD23F", "textTransform": "uppercase", "shadow": { "color": "#00000099", "blurPx": 18, "dx": 0, "dy": 6 }, "align": "center" }
  },
  "look": { "colorLook": "vivid", "grain": 0.1, "vignette": 0.15 },
  "agentHints": "Open on the widest establishing shot. Alternate wide and close shots. Keep chronological order unless the user asks otherwise. Prefer moments with motion on beat-heavy sections. Never repeat a clip; if footage runs short, lengthen shots.",
  "ratios": { "4:5": { "styles": { "title.big": { "sizePx": 140 } } }, "16:9": { "styles": { "title.big": { "sizePx": 120 } } } },
  "casting": { "opener": ["scenery"], "closer": ["people"] },
  "constraints": { "noRepeatClips": true, "insufficientMediaPolicy": "lengthenShots", "keepChronological": true, "textSafeZone": true }
}
