{
  "$schema": "../../schemas/recipe.schema.json",
  "schemaVersion": 1,
  "id": "code-rain",
  "version": "1.0.0",
  "name": "Code Rain",
  "category": "other",
  "description": "Your footage as a hacked feed: an old CRT monitor with scanlines for the build, then on the drop the bright parts dissolve into glowing ASCII rain with block-glitch cuts. Ends on a typed line.",
  "tags": ["hacker", "ascii", "crt", "tech", "glitch"],
  "preview": { "poster": "previews/code-rain.jpg", "loop": "previews/code-rain.mp4", "generatedFrom": "synthetic-sample" },
  "canvas": { "width": 1080, "height": 1920, "fps": { "num": 30, "den": 1 } },
  "duration": { "mode": "fitMusic", "minSec": 8, "targetSec": 16, "maxSec": 30 },
  "inputs": [
    { "id": "clips", "kind": "media", "accept": ["video", "image"], "min": 10, "max": 80, "label": "Clips and photos", "hint": "City lights, screens, night streets, silhouettes", "constraints": { "minClipSec": 0.4 } },
    { "id": "music", "kind": "media", "accept": ["audio"], "min": 1, "max": 1, "label": "Electronic song" },
    { "id": "line", "kind": "text", "label": "Typed line at the end", "default": "> access granted", "optional": true, "maxLength": 40 }
  ],
  "params": [
    { "id": "dropAtS", "type": "seconds", "label": "Drop time in the song (0 = auto)", "default": 0, "min": 0, "max": 600, "step": 0.01 }
  ],
  "music": { "inputId": "music", "required": true, "startPolicy": "loudestSection", "endPolicy": "endOnBar", "fadeOutSec": 0.4, "gainDb": -2, "clipAudioGainDb": -96, "duckUnderSpeech": false },
  "assembler": { "strategy": "beat-montage@1", "options": { "dropDetection": "energyJump" }, "aiSelection": "optional" },
  "structure": [
    { "section": "build", "lengthBeats": 8, "fill": "clips", "cutRule": "every2Beats", "transition": "chroma-glitch", "effects": [ { "assetId": "builtin:fx-crt", "overrides": { "scanlineIntensity": 0.6, "curvature": 0.25, "rgbShift": 0.004 } } ] },
    { "section": "drop", "fill": "clips", "cutRule": "everyBeat", "transition": "chroma-glitch", "effects": [ { "assetId": "builtin:fx-ascii-rain", "overrides": { "gridSize": 10, "glow": 2 } }, { "assetId": "builtin:fx-glitch", "overrides": { "intensity": 0.5 } } ] },
    { "section": "end", "lengthBeats": 4, "fill": "none", "overlays": [ { "kind": "title", "text": "{{inputs.line}}", "styleId": "term", "animationIn": "typewriter", "position": "center" } ] }
  ],
  "styles": {
    "term": { "fontFamily": "Space Mono", "fontWeight": 700, "sizePx": 64, "color": "#39FF88", "align": "center", "shadow": { "color": "#39FF8899", "blurPx": 14, "dx": 0, "dy": 0 } }
  },
  "look": { "colorLook": "coolClean", "effects": [ { "assetId": "builtin:look-cyber", "overrides": { "intensity": 0.5 } } ], "grain": 0, "vignette": 0.2 },
  "casting": { "opener": ["night", "city"], "boost": ["night", "city", "people"], "avoid": ["food"] },
  "agentHints": "ASCII rain grows from bright areas, so pick shots with lights or bright sky against dark parts for the drop. Never repeat a clip.",
  "ratios": { "4:5": {}, "16:9": {} },
  "constraints": { "noRepeatClips": true, "insufficientMediaPolicy": "mergeShots", "keepChronological": false, "textSafeZone": true }
}
