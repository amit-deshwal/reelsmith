{
  "$schema": "../../schemas/recipe.schema.json",
  "schemaVersion": 1,
  "id": "zoom-tunnel",
  "version": "1.0.0",
  "name": "Zoom Tunnel",
  "category": "travel",
  "description": "A trip that punches forward: teal-and-orange grade, every cut a zoom-through with streaks, starting on bars and speeding up to every beat. The place name pops on the first punch.",
  "tags": ["travel", "zoom", "fast", "cinematic"],
  "preview": { "poster": "previews/zoom-tunnel.jpg", "loop": "previews/zoom-tunnel.mp4", "generatedFrom": "synthetic-sample" },
  "canvas": { "width": 1080, "height": 1920, "fps": { "num": 30, "den": 1 } },
  "duration": { "mode": "fitMusic", "minSec": 8, "targetSec": 16, "maxSec": 30 },
  "inputs": [
    { "id": "clips", "kind": "media", "accept": ["video", "image"], "min": 10, "max": 80, "label": "Trip clips and photos", "hint": "Roads, trails, walking shots and wide views; anything with depth", "constraints": { "minClipSec": 0.4 } },
    { "id": "music", "kind": "media", "accept": ["audio"], "min": 1, "max": 1, "label": "Driving song" },
    { "id": "place", "kind": "text", "label": "Place name", "placeholder": "Spiti", "optional": true, "maxLength": 30 }
  ],
  "params": [
    { "id": "punch", "type": "enum", "label": "Transition", "default": "zoom-through", "options": ["zoom-through", "whip-blur", "spin-zoom"] }
  ],
  "music": { "inputId": "music", "required": true, "startPolicy": "firstDownbeat", "endPolicy": "endOnBar", "fadeOutSec": 0.6, "gainDb": -2, "clipAudioGainDb": -96, "duckUnderSpeech": false },
  "assembler": { "strategy": "beat-montage@1", "options": { "transitionParam": "punch", "autoTransitions": ["zoom-through"] }, "aiSelection": "optional" },
  "structure": [
    { "section": "cruise", "lengthBeats": 8, "fill": "clips", "cutRule": "everyBar", "transition": "auto", "overlays": [ { "kind": "placeName", "text": "{{inputs.place}}", "styleId": "place", "animationIn": "pop", "position": "center", "atBeat": 4, "durationBeats": 4 } ] },
    { "section": "accelerate", "fill": "clips", "cutRule": "every2Beats", "transition": "auto" },
    { "section": "warp", "lengthBeats": 8, "fill": "clips", "cutRule": "everyBeat", "transition": "auto" }
  ],
  "styles": {
    "place": { "fontFamily": "Unbounded", "fontWeight": 800, "sizePx": 140, "color": "#FFFFFF", "textTransform": "uppercase", "align": "center", "shadow": { "color": "#00000099", "blurPx": 22, "dx": 0, "dy": 6 } }
  },
  "look": { "colorLook": "vivid", "reelLook": "cinematic-travel", "grain": 0.05, "vignette": 0.1 },
  "casting": { "opener": ["scenery", "water"], "closer": ["scenery", "people"], "boost": ["scenery", "action", "water", "city"] },
  "agentHints": "Shots that move forward (driving, walking, drone) make the zoom feel like one continuous flight. Open on the widest view. Never repeat a clip.",
  "ratios": { "4:5": {}, "16:9": { "styles": { "place": { "sizePx": 120 } } } },
  "constraints": { "noRepeatClips": true, "insufficientMediaPolicy": "mergeShots", "keepChronological": false, "textSafeZone": true }
}
