{
  "$schema": "../../schemas/recipe.schema.json",
  "schemaVersion": 1,
  "id": "countdown-blast",
  "version": "1.0.0",
  "name": "Countdown Blast",
  "category": "beat-cut",
  "description": "A 3-2-1 countdown with a flash on every number, then GO: a cut on every beat that rotates zoom-through, whip-blur and spin-zoom, with a caption on the blast.",
  "tags": ["countdown", "hype", "trip", "launch", "fast"],
  "preview": { "poster": "previews/countdown-blast.jpg", "loop": "previews/countdown-blast.mp4", "generatedFrom": "synthetic-sample" },
  "canvas": { "width": 1080, "height": 1920, "fps": { "num": 30, "den": 1 } },
  "duration": { "mode": "fitMusic", "minSec": 8, "targetSec": 15, "maxSec": 30 },
  "inputs": [
    { "id": "clips", "kind": "media", "accept": ["video", "image"], "min": 12, "max": 100, "label": "Clips and photos", "hint": "The first four are the countdown; then the best stuff", "constraints": { "minClipSec": 0.3 } },
    { "id": "music", "kind": "media", "accept": ["audio"], "min": 1, "max": 1, "label": "Song with a clear beat" },
    { "id": "caption", "kind": "text", "label": "Caption after GO", "placeholder": "goa, finally", "optional": true, "maxLength": 50 }
  ],
  "params": [],
  "music": { "inputId": "music", "required": true, "startPolicy": "firstDownbeat", "endPolicy": "endOnBar", "fadeOutSec": 0.4, "gainDb": -2, "clipAudioGainDb": -96, "duckUnderSpeech": false },
  "assembler": { "strategy": "beat-montage@1", "options": { "autoTransitions": ["zoom-through", "whip-blur", "spin-zoom"] }, "aiSelection": "optional" },
  "structure": [
    {
      "section": "countdown", "lengthBeats": 4, "fill": "clips", "cutRule": "everyBeat", "transition": "flash",
      "overlays": [
        { "kind": "title", "text": "3", "styleId": "count", "animationIn": "pop", "position": "center", "atBeat": 0, "durationBeats": 1 },
        { "kind": "title", "text": "2", "styleId": "count", "animationIn": "pop", "position": "center", "atBeat": 1, "durationBeats": 1 },
        { "kind": "title", "text": "1", "styleId": "count", "animationIn": "pop", "position": "center", "atBeat": 2, "durationBeats": 1 },
        { "kind": "title", "text": "GO", "styleId": "go", "animationIn": "pop", "position": "center", "atBeat": 3, "durationBeats": 1 }
      ]
    },
    { "section": "blast", "fill": "clips", "cutRule": "everyBeat", "transition": "auto", "overlays": [ { "kind": "title", "text": "{{inputs.caption}}", "styleId": "caption", "animationIn": "slideUp", "position": "lowerThird", "atBeat": 0, "durationBeats": 8 } ] }
  ],
  "styles": {
    "count": { "fontFamily": "Anton", "fontWeight": 400, "sizePx": 420, "color": "#FFFFFF", "align": "center", "shadow": { "color": "#000000AA", "blurPx": 24, "dx": 0, "dy": 8 } },
    "go": { "fontFamily": "Anton", "fontWeight": 400, "sizePx": 380, "color": "#FFD23F", "textTransform": "uppercase", "align": "center", "shadow": { "color": "#000000AA", "blurPx": 24, "dx": 0, "dy": 8 } },
    "caption": { "fontFamily": "Inter Tight", "fontWeight": 800, "sizePx": 72, "color": "#FFFFFF", "align": "center", "shadow": { "color": "#00000099", "blurPx": 10, "dx": 0, "dy": 3 } }
  },
  "look": { "colorLook": "vivid", "grain": 0, "vignette": 0 },
  "casting": { "opener": ["people", "portrait"], "boost": ["action", "dancing", "celebrating", "laughing", "water"] },
  "agentHints": "The four countdown shots should be calm close-ups or anticipation (packing, waiting, a road ahead); the blast should start on the most explosive shot. Never repeat a clip.",
  "ratios": { "4:5": {}, "1:1": { "styles": { "count": { "sizePx": 340 }, "go": { "sizePx": 300 } } } },
  "constraints": { "noRepeatClips": true, "insufficientMediaPolicy": "mergeShots", "keepChronological": false, "textSafeZone": true }
}
