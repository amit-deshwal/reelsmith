{
  "$schema": "../../schemas/recipe.schema.json",
  "schemaVersion": 1,
  "id": "heat-vision",
  "version": "1.0.0",
  "name": "Heat Vision",
  "category": "beat-cut",
  "description": "Seen through a heat camera: the build plays in normal colour, then on the drop every shot flips to thermal vision with a HUD, an RGB split and glitch cuts on every beat.",
  "tags": ["thermal", "glitch", "hype", "night", "drop"],
  "preview": { "poster": "previews/heat-vision.jpg", "loop": "previews/heat-vision.mp4", "generatedFrom": "synthetic-sample" },
  "canvas": { "width": 1080, "height": 1920, "fps": { "num": 30, "den": 1 } },
  "duration": { "mode": "fitMusic", "minSec": 8, "targetSec": 15, "maxSec": 30 },
  "inputs": [
    { "id": "clips", "kind": "media", "accept": ["video", "image"], "min": 10, "max": 100, "label": "Clips and photos", "hint": "People moving, lights, fire, sun: anything with hot spots", "constraints": { "minClipSec": 0.3 } },
    { "id": "music", "kind": "media", "accept": ["audio"], "min": 1, "max": 1, "label": "Song with a hard drop" },
    { "id": "label", "kind": "text", "label": "HUD line on the drop", "default": "SIGNAL FOUND", "optional": true, "maxLength": 30 }
  ],
  "params": [
    { "id": "dropAtS", "type": "seconds", "label": "Drop time in the song (0 = auto)", "default": 0, "min": 0, "max": 600, "step": 0.01 }
  ],
  "music": { "inputId": "music", "required": true, "startPolicy": "loudestSection", "endPolicy": "endOnBar", "fadeOutSec": 0.3, "gainDb": -2, "clipAudioGainDb": -96, "duckUnderSpeech": false },
  "assembler": { "strategy": "beat-montage@1", "options": { "dropDetection": "energyJump" }, "aiSelection": "optional" },
  "structure": [
    { "section": "build", "lengthBeats": 8, "fill": "clips", "cutRule": "every2Beats", "transition": "cut", "effects": [ { "assetId": "builtin:look-cinestill", "overrides": { "intensity": 0.7 } } ] },
    {
      "section": "drop", "fill": "clips", "cutRule": "everyBeat", "transition": "chroma-glitch",
      "effects": [ { "assetId": "builtin:fx-thermal", "overrides": { "contrast": 1.8, "hud": 1 } }, { "assetId": "builtin:fx-rgb-split", "overrides": { "amount": 0.006 } } ],
      "overlays": [ { "kind": "label", "text": "{{inputs.label}}", "styleId": "hud", "animationIn": "typewriter", "position": "lowerThird", "atBeat": 0, "durationBeats": 8 } ]
    }
  ],
  "styles": {
    "hud": { "fontFamily": "Space Mono", "fontWeight": 700, "sizePx": 56, "color": "#FFFFFF", "textTransform": "uppercase", "align": "center", "shadow": { "color": "#000000CC", "blurPx": 6, "dx": 0, "dy": 2 } }
  },
  "look": { "colorLook": "none", "grain": 0, "vignette": 0 },
  "casting": { "opener": ["night", "people"], "boost": ["people", "action", "dancing", "night"] },
  "agentHints": "Thermal reads best on people and bright lights against dark backgrounds, so put those on the drop. The build should be calm, normal-looking shots so the flip hits hard. Never repeat a clip.",
  "ratios": { "4:5": {}, "1:1": {} },
  "constraints": { "noRepeatClips": true, "insufficientMediaPolicy": "mergeShots", "keepChronological": false, "textSafeZone": true }
}
