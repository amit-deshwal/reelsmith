{
  "$schema": "../../schemas/recipe.schema.json",
  "schemaVersion": 1,
  "id": "mirror-world",
  "version": "1.0.0",
  "name": "Mirror World",
  "category": "travel",
  "description": "A place that folds in on itself: the first part mirrored left to right, the middle flipped top to bottom like a lake reflection, and a six-way kaleidoscope finale. Every cut is a cube turn or slide.",
  "tags": ["travel", "mirror", "symmetry", "architecture", "trippy"],
  "preview": { "poster": "previews/mirror-world.jpg", "loop": "previews/mirror-world.mp4", "generatedFrom": "synthetic-sample" },
  "canvas": { "width": 1080, "height": 1920, "fps": { "num": 30, "den": 1 } },
  "duration": { "mode": "fitMusic", "minSec": 10, "targetSec": 18, "maxSec": 40 },
  "inputs": [
    { "id": "clips", "kind": "media", "accept": ["video", "image"], "min": 8, "max": 60, "label": "Trip clips and photos", "hint": "Buildings, streets, skylines and water; symmetry loves straight lines", "constraints": { "minClipSec": 0.6 } },
    { "id": "music", "kind": "media", "accept": ["audio"], "min": 1, "max": 1, "label": "Song" },
    { "id": "place", "kind": "text", "label": "Place name", "placeholder": "Jaipur", "optional": true, "maxLength": 30 }
  ],
  "params": [],
  "music": { "inputId": "music", "required": true, "startPolicy": "firstDownbeat", "endPolicy": "endOnBar", "fadeOutSec": 0.8, "gainDb": -3, "clipAudioGainDb": -96, "duckUnderSpeech": false },
  "assembler": { "strategy": "beat-montage@1", "options": { "autoTransitions": ["cube-turn", "slide-over"] }, "aiSelection": "optional" },
  "structure": [
    { "section": "fold", "lengthBeats": 8, "fill": "clips", "cutRule": "every2Beats", "transition": "auto", "effects": [ { "assetId": "builtin:fx-mirror", "overrides": { "mode": 0 } } ], "overlays": [ { "kind": "placeName", "text": "{{inputs.place}}", "styleId": "place", "animationIn": "pop", "position": "center" } ] },
    { "section": "reflect", "fill": "clips", "cutRule": "every2Beats", "transition": "auto", "effects": [ { "assetId": "builtin:fx-mirror", "overrides": { "mode": 2 } } ] },
    { "section": "prism", "lengthBeats": 8, "fill": "clips", "cutRule": "everyBeat", "transition": "auto", "effects": [ { "assetId": "builtin:fx-kaleidoscope", "overrides": { "segments": 6 } } ] }
  ],
  "styles": {
    "place": { "fontFamily": "Cormorant Garamond", "fontWeight": 700, "sizePx": 150, "color": "#FFFFFF", "textTransform": "uppercase", "letterSpacingEm": 0.2, "align": "center", "shadow": { "color": "#00000099", "blurPx": 20, "dx": 0, "dy": 4 } }
  },
  "look": { "colorLook": "coolClean", "effects": [ { "assetId": "builtin:look-fuji-chrome" } ], "grain": 0.04, "vignette": 0.1 },
  "casting": { "opener": ["city", "scenery"], "closer": ["scenery", "water"], "boost": ["city", "scenery", "water", "detail"], "avoid": ["portrait"] },
  "agentHints": "Faces look odd mirrored, so put buildings, streets, water and skylines in this reel. Shots with a strong centre line (a road, a doorway, a horizon) make the best mirrors. Never repeat a clip.",
  "ratios": { "4:5": {}, "1:1": {} },
  "constraints": { "noRepeatClips": true, "insufficientMediaPolicy": "lengthenShots", "keepChronological": false, "textSafeZone": true }
}
