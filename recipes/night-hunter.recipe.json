{
  "$schema": "../../schemas/recipe.schema.json",
  "schemaVersion": 1,
  "id": "night-hunter",
  "version": "1.0.0",
  "name": "Night Hunter",
  "category": "other",
  "description": "A movie-trailer reel: a widescreen letterbox and cold tungsten grade for the slow build, then the person lights up white-hot on a dark blue world as the drop cuts every beat.",
  "tags": ["trailer", "cinematic", "predator", "solo", "dramatic"],
  "preview": { "poster": "previews/night-hunter.jpg", "loop": "previews/night-hunter.mp4", "generatedFrom": "synthetic-sample" },
  "canvas": { "width": 1080, "height": 1920, "fps": { "num": 30, "den": 1 } },
  "duration": { "mode": "fitMusic", "minSec": 8, "targetSec": 16, "maxSec": 30 },
  "inputs": [
    { "id": "clips", "kind": "media", "accept": ["video", "image"], "min": 8, "max": 60, "label": "Clips and photos with a person in them", "hint": "The heat look finds the person in each shot; shots without one turn cold blue", "constraints": { "minClipSec": 0.5 } },
    { "id": "music", "kind": "media", "accept": ["audio"], "min": 1, "max": 1, "label": "Dark song with a drop" },
    { "id": "title", "kind": "text", "label": "Trailer title", "default": "THEY NEVER SAW ME COMING", "optional": true, "maxLength": 40 }
  ],
  "params": [
    { "id": "dropAtS", "type": "seconds", "label": "Drop time in the song (0 = auto)", "default": 0, "min": 0, "max": 600, "step": 0.01 }
  ],
  "music": { "inputId": "music", "required": true, "startPolicy": "loudestSection", "endPolicy": "endOnBar", "fadeOutSec": 0.5, "gainDb": -2, "clipAudioGainDb": -96, "duckUnderSpeech": false },
  "assembler": { "strategy": "beat-montage@1", "options": { "dropDetection": "energyJump" }, "aiSelection": "recommended" },
  "structure": [
    {
      "section": "build", "lengthBeats": 8, "fill": "clips", "cutRule": "everyBar", "transition": "dipToBlack",
      "effects": [ { "assetId": "builtin:look-cinestill", "overrides": { "intensity": 0.85 } }, { "assetId": "builtin:fx-cinema-bars", "overrides": { "size": 0.12 } } ],
      "overlays": [ { "kind": "title", "text": "{{inputs.title}}", "styleId": "trailer", "animationIn": "fade", "position": "center", "atBeat": 2, "durationBeats": 6 } ]
    },
    { "section": "drop", "fill": "clips", "cutRule": "everyBeat", "transition": "flash", "effects": [ { "assetId": "builtin:fx-predator", "overrides": { "heat": 1.1, "scan": 1 } } ] }
  ],
  "styles": {
    "trailer": { "fontFamily": "Oswald", "fontWeight": 700, "sizePx": 72, "color": "#FFFFFF", "textTransform": "uppercase", "letterSpacingEm": 0.12, "align": "center" }
  },
  "look": { "colorLook": "none", "grain": 0.08, "vignette": 0.2 },
  "casting": { "opener": ["portrait", "people"], "boost": ["people", "portrait", "action", "dancing"], "avoid": ["food", "detail", "scenery"] },
  "agentHints": "Every drop shot must have a clearly visible person, ideally moving; empty scenery goes cold and dark under the heat look. Put the slow, mysterious shots in the build. Never repeat a clip.",
  "ratios": { "4:5": {} },
  "constraints": { "noRepeatClips": true, "insufficientMediaPolicy": "mergeShots", "keepChronological": false, "textSafeZone": true }
}
