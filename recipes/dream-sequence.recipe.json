{
  "$schema": "../../schemas/recipe.schema.json",
  "schemaVersion": 1,
  "id": "dream-sequence",
  "version": "1.0.0",
  "name": "Dream Sequence",
  "category": "other",
  "description": "Soft and unreal: a watercolour wash over every shot, slow cuts on bars that melt through ripple, fluted-glass and light-leak dissolves, and a handwritten line floating in the middle.",
  "tags": ["dreamy", "soft", "romantic", "nature", "calm"],
  "preview": { "poster": "previews/dream-sequence.jpg", "loop": "previews/dream-sequence.mp4", "generatedFrom": "synthetic-sample" },
  "canvas": { "width": 1080, "height": 1920, "fps": { "num": 30, "den": 1 } },
  "duration": { "mode": "fitMusic", "minSec": 10, "targetSec": 18, "maxSec": 40 },
  "inputs": [
    { "id": "clips", "kind": "media", "accept": ["video", "image"], "min": 5, "max": 40, "label": "Clips and photos", "hint": "Flowers, water, sky, slow moments, people from behind", "constraints": { "minClipSec": 1 } },
    { "id": "music", "kind": "media", "accept": ["audio"], "min": 1, "max": 1, "label": "Slow song" },
    { "id": "line", "kind": "text", "label": "Line in the middle", "placeholder": "somewhere I keep going back to", "optional": true, "maxLength": 60 }
  ],
  "params": [],
  "music": { "inputId": "music", "required": true, "startPolicy": "fromStart", "endPolicy": "fadeOut", "fadeOutSec": 2, "gainDb": -4, "clipAudioGainDb": -96, "duckUnderSpeech": false },
  "assembler": { "strategy": "beat-montage@1", "options": { "autoTransitions": ["ripple-dissolve", "fluted-glass", "light-leak"] }, "aiSelection": "optional" },
  "structure": [
    { "section": "drift", "fill": "clips", "cutRule": "everyBar", "transition": "auto", "overlays": [ { "kind": "title", "text": "{{inputs.line}}", "styleId": "script", "animationIn": "fade", "position": "center", "atBeat": 4, "durationBeats": 12 } ] }
  ],
  "styles": {
    "script": { "fontFamily": "Dancing Script", "fontWeight": 700, "sizePx": 96, "color": "#FFFFFF", "align": "center", "shadow": { "color": "#00000066", "blurPx": 24, "dx": 0, "dy": 4 } }
  },
  "look": { "colorLook": "mutedMatte", "reelLook": "watercolor-dream", "grain": 0.05, "vignette": 0.15 },
  "casting": { "opener": ["scenery", "water"], "closer": ["scenery", "people"], "boost": ["scenery", "water", "detail"], "avoid": ["shouting", "falling"] },
  "agentHints": "Choose the calmest moments of each clip; avoid shaky or loud shots. Keep it slow: never cut faster than a bar. Never repeat a clip.",
  "ratios": { "4:5": {}, "1:1": {} },
  "constraints": { "noRepeatClips": true, "insufficientMediaPolicy": "lengthenShots", "keepChronological": false, "textSafeZone": true }
}
