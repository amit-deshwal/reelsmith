{
  "$schema": "../../schemas/recipe.schema.json",
  "schemaVersion": 1,
  "id": "zine-riot",
  "version": "1.0.0",
  "name": "Zine Riot",
  "category": "beat-cut",
  "description": "A risograph-print zine at full volume: two-colour ink grade, a cut on every beat that never uses the same transition twice in a row (slide, tile pop, glitch, whip), and a fat uppercase headline.",
  "tags": ["indie", "fashion", "music", "bold", "fast"],
  "preview": { "poster": "previews/zine-riot.jpg", "loop": "previews/zine-riot.mp4", "generatedFrom": "synthetic-sample" },
  "canvas": { "width": 1080, "height": 1920, "fps": { "num": 30, "den": 1 } },
  "duration": { "mode": "fitMusic", "minSec": 8, "targetSec": 15, "maxSec": 30 },
  "inputs": [
    { "id": "clips", "kind": "media", "accept": ["video", "image"], "min": 12, "max": 120, "label": "Clips and photos", "hint": "Outfits, streets, gigs, textures", "constraints": { "minClipSec": 0.3 } },
    { "id": "music", "kind": "media", "accept": ["audio"], "min": 1, "max": 1, "label": "Loud song" },
    { "id": "headline", "kind": "text", "label": "Headline", "default": "issue no. 01", "optional": true, "maxLength": 40 }
  ],
  "params": [
    { "id": "mix", "type": "enum", "label": "Transitions", "default": "auto", "options": ["auto", "slide-over", "tile-pop", "chroma-glitch", "whip-blur", "cut"] },
    { "id": "cutRule", "type": "enum", "label": "Cut on", "default": "everyBeat", "options": ["everyBeat", "every2Beats"] }
  ],
  "music": { "inputId": "music", "required": true, "startPolicy": "loudestSection", "endPolicy": "endOnBar", "fadeOutSec": 0.3, "gainDb": -2, "clipAudioGainDb": -96, "duckUnderSpeech": false },
  "assembler": { "strategy": "beat-montage@1", "options": { "transitionParam": "mix", "autoTransitions": ["slide-over", "tile-pop", "chroma-glitch", "whip-blur"] }, "aiSelection": "optional" },
  "structure": [
    { "section": "cover", "lengthBeats": 4, "fill": "clips", "cutRule": "everyBar", "transition": "cut", "overlays": [ { "kind": "title", "text": "{{inputs.headline}}", "styleId": "headline", "animationIn": "slideUp", "position": "lowerThird" } ] },
    { "section": "pages", "fill": "clips", "cutRule": "everyBeat", "transition": "auto" }
  ],
  "styles": {
    "headline": { "fontFamily": "Bowlby One", "fontWeight": 400, "sizePx": 120, "color": "#FF4F8B", "textTransform": "uppercase", "align": "center", "shadow": { "color": "#1D3BFFCC", "blurPx": 0, "dx": 6, "dy": 6 } }
  },
  "look": { "colorLook": "vivid", "reelLook": "riso-zine", "grain": 0.1, "vignette": 0 },
  "casting": { "opener": ["portrait", "posing"], "closer": ["portrait", "people"], "boost": ["portrait", "posing", "city", "detail", "dancing"] },
  "agentHints": "Mix close textures with full outfits and faces. Open on the strongest portrait so the headline sits on it. Never repeat a clip.",
  "ratios": { "4:5": {}, "1:1": {} },
  "constraints": { "noRepeatClips": true, "insufficientMediaPolicy": "mergeShots", "keepChronological": false, "textSafeZone": true }
}
