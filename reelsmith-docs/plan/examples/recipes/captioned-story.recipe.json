{
  "$schema": "../../schemas/recipe.schema.json",
  "schemaVersion": 1,
  "id": "captioned-story",
  "version": "1.0.0",
  "name": "Captioned Story",
  "category": "captioned-story",
  "description": "Talking-to-camera story with word-timed captions, silences tightened, and your B-roll laid over the matching sentences.",
  "preview": { "poster": "previews/captioned-story.jpg", "loop": "previews/captioned-story.mp4", "generatedFrom": "synthetic-sample" },
  "canvas": { "width": 1080, "height": 1920, "fps": { "num": 30, "den": 1 } },
  "duration": { "mode": "fitContent", "minSec": 10, "targetSec": 45, "maxSec": 180 },
  "inputs": [
    { "id": "talking", "kind": "media", "accept": ["video"], "min": 1, "max": 6, "label": "Talking clips", "constraints": { "requiresSpeech": true } },
    { "id": "broll", "kind": "media", "accept": ["video", "image"], "min": 0, "max": 40, "label": "B-roll (optional)" },
    { "id": "music", "kind": "media", "accept": ["audio"], "min": 0, "max": 1, "label": "Background music (optional)" },
    { "id": "hook", "kind": "text", "label": "Opening hook text (optional)", "optional": true, "maxLength": 80 }
  ],
  "params": [
    { "id": "captionStyle", "type": "enum", "label": "Caption style", "default": "highlight-word", "options": ["clean-white", "highlight-word", "boxed", "karaoke", "pop-word", "minimal-lower"] },
    { "id": "tighten", "type": "enum", "label": "Tighten pauses", "default": "balanced", "options": ["off", "light", "balanced", "tight"] },
    { "id": "brollEvery", "type": "seconds", "label": "B-roll roughly every", "default": 6, "min": 2, "max": 30, "step": 0.5 }
  ],
  "music": { "inputId": "music", "required": false, "startPolicy": "fromStart", "endPolicy": "fadeOut", "fadeOutSec": 2, "gainDb": -18, "clipAudioGainDb": 0, "duckUnderSpeech": true },
  "assembler": { "strategy": "captioned-story@1", "options": { "pauseThresholdMs": { "light": 900, "balanced": 600, "tight": 350 }, "keepBreathMs": 120 }, "aiSelection": "recommended" },
  "structure": [
    { "section": "hook", "lengthSec": 3, "fill": "speech", "overlays": [ { "kind": "title", "text": "{{inputs.hook}}", "styleId": "hook", "position": "upperThird", "animationIn": "pop" } ] },
    { "section": "story", "fill": "speech", "cutRule": "onSpeechPhrases", "overlays": [ { "kind": "captions", "styleId": "caption.default", "position": "lowerThird" } ] }
  ],
  "styles": {
    "hook": { "fontFamily": "Inter", "fontWeight": 800, "sizePx": 72, "color": "#FFFFFF", "backgroundColor": "#000000B3", "backgroundPaddingPx": 18, "backgroundRadiusPx": 16, "align": "center" },
    "caption.default": { "fontFamily": "Inter", "fontWeight": 800, "sizePx": 64, "color": "#FFFFFF", "activeWordColor": "#FFD23F", "strokeColor": "#000000", "strokePx": 6, "animation": "highlightWord", "align": "center" }
  },
  "agentHints": "Keep the speaker's meaning intact. Cut only pauses and clear false starts unless asked. Place B-roll over sentences that mention what the B-roll shows (use search_media). Never cover the first 2 seconds of the hook with B-roll.",
  "constraints": { "noRepeatClips": true, "insufficientMediaPolicy": "lengthenShots", "keepChronological": true, "textSafeZone": true }
}
